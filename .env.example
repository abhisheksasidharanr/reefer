# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/reefer?schema=public"

# Session signing secret (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"

# Pre-fill the sign-in form (defaults to the seeded admin). On in development, off in production unless set to true.
# LOGIN_PREFILL=true
# LOGIN_DEFAULT_EMAIL="admin@example.com"
# LOGIN_DEFAULT_PASSWORD="admin1234"
